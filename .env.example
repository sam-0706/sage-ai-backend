# ---- runtime
APP_ENV=development                 # development | preview | production
PUBLIC_BASE_URL=                    # e.g. https://sage-ai-backend.vercel.app (used for webhook URLs)
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,app://sage
DEV_AUTH_BYPASS=false               # local testing only; refused unless APP_ENV=development

# ---- Supabase Postgres (transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Clerk
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...   # used to derive issuer + JWKS URL
CLERK_AUTHORIZED_PARTIES=           # optional: comma-separated allowed `azp` origins

# ---- OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- OmniDimension voice
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=                   # created by: python -m scripts.setup_voice_agent
OMNIDIM_EXAM_AGENT_ID=              # created by: python -m scripts.setup_voice_agent --exam
OMNIDIM_FROM_NUMBER_ID=
OMNIDIM_WEBHOOK_SECRET=             # random string; part of the webhook URL
VOICE_ALLOWED_TEST_NUMBERS=         # optional extra allow-listed numbers (E.164, comma-separated)
VOICE_ALLOW_OWN_NUMBER=true

# ---- OpenRouter (desktop auto-apply agent; server-side proxy — the key never ships in the desktop app)
OPENROUTER_API_KEY=
AUTOAPPLY_VISION_MODEL=~openai/gpt-latest
AUTOAPPLY_TEXT_MODEL=~openai/gpt-mini-latest

# ---- Razorpay (TEST keys only — live keys are refused)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- operations
CRON_SECRET=                        # Vercel Cron sends Authorization: Bearer $CRON_SECRET
SUPERADMIN_EMAILS=
